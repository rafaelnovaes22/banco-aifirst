{
  "name": "banco-aifirst",
  "version": "0.1.0",
  "description": "Banco AI First em sandbox operacional: agentes sugerem, regras decidem e humanos aprovam.",
  "type": "module",
  "scripts": {
    "test": "vitest run && node tests/bank-core.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && node evals/smoke.mjs && node scripts/guardrails-check.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.{ts,mjs}\" \"*.{json,ts,mjs,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.{ts,mjs}\" \"*.{json,ts,mjs,md}\"",
    "start": "node dist/main.js",
    "demo": "npm run build --silent && node dist/demo/run-demo.js"
  },
  "keywords": [
    "fintech",
    "baas",
    "pix",
    "mei",
    "ai-first"
  ],
  "author": "Rafael de Novaes",
  "license": "UNLICENSED",
  "private": true,
  "lint-staged": {
    "*.{ts,tsx,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mjs}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "10.9.1",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "fastify": "^5.12.1",
    "zod": "^3.24.1"
  }
}
