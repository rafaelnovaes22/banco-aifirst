# banco-aifirst — Fastify API + Static sites
# Copie para .env e preencha os valores

# Servidor
PORT=3000
NODE_ENV=production
APP_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/banco_aifirst

# BaaS / Pix (sandbox)
BAAS_PROVIDER=mock
BAAS_WEBHOOK_SECRET=
BAAS_API_KEY=
BAAS_ACCOUNT_ID=

# Sessão / Auth
SESSION_SECRET=
CSRF_SECRET=
JWT_SECRET=

# Seed demo
SEED_DEMO=false

# Observabilidade (opcional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=banco-aifirst